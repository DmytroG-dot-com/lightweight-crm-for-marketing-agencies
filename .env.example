NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace-with-a-long-random-secret

# Optional global fallback. Agency-specific OpenAI keys can instead be saved in Settings.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini

# Required to encrypt agency-specific AI keys saved through Settings.
AI_SETTINGS_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
